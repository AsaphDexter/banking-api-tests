{
  "name": "banking-api-tests",
  "version": "1.0.0",
  "description": "Automated API tests and performance tests for the Basic Banking Application REST API",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "perf:smoke": "k6 run perf/smoke.js",
    "perf:load": "k6 run perf/load.js",
    "perf:login": "k6 run perf/login-throughput.js",
    "perf:isolation": "k6 run perf/login-isolation.js",
    "docker:test": "docker compose up --build --exit-code-from tests",
    "docker:down": "docker compose down -v"
  },
  "license": "MIT",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
